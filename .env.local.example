# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# (Project Settings → API)

# Vão para o navegador — podem ser públicas.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-public

# Fica SÓ no servidor. Ignora todas as regras de acesso do banco.
# Nunca coloque NEXT_PUBLIC_ na frente dela.
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role
